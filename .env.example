# =============================================================================
# Fodan College LMS — environment configuration
#
# Copy this file to `.env` and fill in real values.
# NEVER commit a .env file that contains real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
NODE_ENV="development"

# Public base URL of the deployment. Used for links in notifications and for
# same-origin checks on state-changing requests.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Fodan College"


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL (production target):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fodan_college?schema=public"

# Direct (non-pooled) connection, used only by Prisma Migrate. Connection
# poolers rewrite the prepared statements migrations rely on, so pointing this
# at the pooler will make `prisma migrate deploy` fail. With a plain local
# Postgres or SQLite it is simply the same value as DATABASE_URL. On Neon it is
# the "unpooled" string, while DATABASE_URL should be the pooled one.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fodan_college?schema=public"

# SQLite (zero-install local development). Run `npm run db:use:sqlite` first,
# then set both:
# DATABASE_URL="file:./dev.db"
# DIRECT_URL="file:./dev.db"


# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Used to derive the HMAC keys that protect session tokens, access codes,
# password-reset tokens and the CSRF double-submit token.
AUTH_SECRET="CHANGE_ME_generate_a_64_byte_random_string"

# Optional: rotate by adding the previous value here so existing sessions and
# unexpired tokens keep validating during a rollout. Comma-separated.
AUTH_SECRET_PREVIOUS=""

# bcrypt work factor. 12 is a sensible production default; lower it to 10 only
# on constrained hardware, never below 10.
PASSWORD_BCRYPT_ROUNDS="12"


# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------
# Absolute session lifetime, in minutes (default 12 hours).
SESSION_ABSOLUTE_TIMEOUT_MINUTES="720"
# Idle timeout, in minutes. A session unused for this long is rejected.
SESSION_IDLE_TIMEOUT_MINUTES="120"
# Name of the session cookie.
SESSION_COOKIE_NAME="fodan_session"


# -----------------------------------------------------------------------------
# Brute-force protection / rate limiting
# -----------------------------------------------------------------------------
LOGIN_MAX_ATTEMPTS="6"
LOGIN_LOCKOUT_MINUTES="15"
# Set to "memory" (single instance) or "redis" (multi-instance deployments).
RATE_LIMIT_DRIVER="memory"
REDIS_URL=""


# -----------------------------------------------------------------------------
# Initial Super Admin (bootstrap only)
# -----------------------------------------------------------------------------
# Consumed once by `npm run db:seed`. The password is hashed before storage and
# the account is flagged `mustChangePassword`, so it must be replaced at first
# login. Never hard-code these in application source.
SUPERADMIN_USERNAME="FBanjo"
SUPERADMIN_PASSWORD="CHANGE_ME_before_seeding"
SUPERADMIN_EMAIL="fodancollege@gmail.com"
SUPERADMIN_FULLNAME="Banjo Folahan Daniel"
SUPERADMIN_PHONE="08067578112"


# -----------------------------------------------------------------------------
# File storage
# -----------------------------------------------------------------------------
# "local" writes to STORAGE_LOCAL_DIR (kept outside the public web root).
# "s3" targets any S3-compatible object store.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# Maximum upload size in megabytes, per file.
UPLOAD_MAX_SIZE_MB="200"

# S3 / S3-compatible (Cloudflare R2, Backblaze B2, MinIO, DigitalOcean Spaces)
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Set to "true" for MinIO and most self-hosted gateways.
S3_FORCE_PATH_STYLE="false"


# -----------------------------------------------------------------------------
# Email (password reset & verification). Optional in development — when unset,
# messages are written to the server log instead of being sent.
# -----------------------------------------------------------------------------
MAIL_DRIVER="log"
MAIL_FROM="Fodan College <fodancollege@gmail.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"


# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
# Comma-separated list of extra allowed origins for state-changing requests.
# Leave empty unless the app is served from more than one hostname.
ALLOWED_ORIGINS=""

# Set to "true" to record client IP addresses in the audit log. Check your local
# data-protection obligations before enabling in production.
AUDIT_RECORD_IP="true"
